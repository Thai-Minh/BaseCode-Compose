<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/audio_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/audio_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="UseAppTint"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Widget hosts inflate framework ImageViews, which need android:tint. -->
    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/audio_widget_artwork_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/audio_widget_placeholder"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_audio"
            android:tint="#607786" />

        <ImageView
            android:id="@+id/audio_widget_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/audio_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#202D38"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/audio_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#617381"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/audio_widget_previous"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:contentDescription="@string/audio_previous"
        android:padding="8dp"
        android:src="@drawable/ic_previous"
        android:tint="#405360" />

    <ImageView
        android:id="@+id/audio_widget_toggle"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:contentDescription="@string/audio_play"
        android:padding="7dp"
        android:src="@drawable/ic_play"
        android:tint="#202D38" />

    <ImageView
        android:id="@+id/audio_widget_next"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:contentDescription="@string/audio_next"
        android:padding="8dp"
        android:src="@drawable/ic_next"
        android:tint="#405360" />
</LinearLayout>
